<%@ page pageEncoding="UTF-8" %>
<%-- inicio.jspf: etiquetas JSTL y conexión a la base de datos. Lo incluye toda página. --%>
<%@ taglib prefix="c"   uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn"  uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ page import="java.io.InputStream, java.util.Properties" %>
<fmt:requestEncoding value="UTF-8"/>
<fmt:setLocale value="es_CO"/>
<fmt:setTimeZone value="America/Bogota"/>

<%--
  Credenciales de la base de datos.
  Se leen de WEB-INF/db.properties, archivo local que NO se versiona en Git.
  En Docker/Render ese archivo lo genera el entrypoint con las variables de
  entorno DB_URL, DB_USER y DB_PASSWORD.
--%>
<%
  Properties cfg = new Properties();
  InputStream cfgIn = application.getResourceAsStream("/WEB-INF/db.properties");
  if (cfgIn != null) {
    try { cfg.load(cfgIn); } finally { cfgIn.close(); }
  }
  String dbUrl  = cfg.getProperty("db.url", "");
  String dbUser = cfg.getProperty("db.user", "");
  String dbPass = cfg.getProperty("db.password", "");
%>
<c:set var="dbUrl"  value="<%= dbUrl %>"/>
<c:set var="dbUser" value="<%= dbUser %>"/>
<c:set var="dbPass" value="<%= dbPass %>"/>

<sql:setDataSource var="bd"
  driver="com.mysql.jdbc.Driver"
  url="${dbUrl}"
  user="${dbUser}"
  password="${dbPass}"/>
