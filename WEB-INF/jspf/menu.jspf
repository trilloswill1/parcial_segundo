<%@ page pageEncoding="UTF-8" %>
<%-- menu.jspf: menú lateral según el rol de la sesión; marca activa con menuActivo --%>
<div class="sidebar-marca">
  <span class="sidebar-marca-icono"><i class="fas fa-graduation-cap"></i></span>
  <span class="sidebar-marca-texto"><strong>UTS</strong><small>Trabajos de Grado</small></span>
</div>

<nav class="sidebar-nav">
  <c:choose>

    <c:when test="${sessionScope.usuarioRol == 'administrador'}">
